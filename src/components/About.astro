---
import { Image } from 'astro:assets';
import portrait from '../assets/profile-portrait.jpg';
import { about, person } from '../data/profile';
import SectionHead from './SectionHead.astro';
---

<section id="about" class="section">
  <SectionHead label="01 / About" title={about.heading} />

  <div class="about-grid">
    <div class="about-photo reveal">
      <div class="portrait">
        <span class="frame" aria-hidden="true"></span>
        <Image
          src={portrait}
          alt={`${person.name} in a black polo, seen in profile against a hazy sunset on a beach`}
          widths={[300, 600, 900]}
          sizes="300px"
          format="webp"
          quality={82}
          loading="lazy"
        />
      </div>
      <p class="photo-name">{person.name}</p>
      <p class="photo-loc">{person.city}, {person.region}</p>
    </div>

    <div class="about-copy reveal">
      <p class="about-lead">{about.lead}</p>

      <div class="stats">
        {
          about.stats.map((stat) => (
            <div class="stat tilt">
              <span class="stat-num"><span data-count={stat.value}>{stat.value}</span>{stat.suffix}</span>
              <span class="stat-text">{stat.text}</span>
            </div>
          ))
        }
      </div>

      <dl class="facts">
        <dt>Spoken languages</dt>
        <dd>{person.languages.join(', ')}</dd>
        <dt>Hobbies &amp; interests</dt>
        <dd>{person.interests}</dd>
      </dl>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  .about-photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  .portrait {
    position: relative;
    width: 300px;
    aspect-ratio: 3 / 4;
    margin-bottom: 22px;
  }
  .portrait :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 22px;
    border: 1px solid var(--line-3);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
  }
  .frame {
    position: absolute;
    inset: -12px;
    border-radius: 32px;
    border: 2px dashed var(--accent);
    opacity: 0.55;
    animation: glowline 4s ease-in-out infinite;
  }
  .photo-name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 22px;
  }
  .photo-loc {
    font-size: 15px;
    color: var(--dim);
  }
  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .about-lead {
    font-size: 20px;
    line-height: 1.7;
    color: var(--text-2);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .stat {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stat-num {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(44px, 4.4vw, 64px);
    line-height: 1;
    color: var(--accent);
  }
  .stat-text {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.5;
  }
  .facts {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    row-gap: 14px;
    font-size: 16px;
  }
  .facts dt {
    color: var(--dim);
  }


  @media (max-width: 1180px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 48px;
    }
  }
  @media (max-width: 720px) {
    .about-lead {
      font-size: 17px;
    }
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
    .facts {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 4px;
    }
    .facts dd {
      margin-bottom: 12px;
    }
  }
</style>
