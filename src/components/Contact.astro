---
import { Image, getImage } from 'astro:assets';
import profile from '../assets/profile.jpg';
import { person, site } from '../data/profile';

// Data the browser uses to draw the downloadable card (PNG / PDF), kept in sync with the card shown below.
const cardPhoto = await getImage({ src: profile, width: 600, format: 'webp', quality: 88 });
const cardData = {
  name: person.name,
  title: person.title,
  company: person.company,
  frontLeft: `${person.city}, India`,
  frontRight: 'Java · Spring Boot · Kafka',
  backLines: [
    person.email,
    person.linkedinLabel,
    person.githubLabel,
    `${person.city}, ${person.region}, ${person.country}`,
  ],
  photo: cardPhoto.src,
  fileBase: person.name.replace(/\s+/g, '-'),
};
---

<section id="contact" class="section section-line contact">
  <div class="orb glow" aria-hidden="true"></div>
  <p class="label">06 / Contact</p>
  <h2 class="contact-h">Let's talk.</h2>
  <p class="contact-sub">
    Questions, ideas, or just want to say hello? Send me a message, or save my card.
  </p>

  <div class="contact-grid">
    <div class="card-col">
      <div class="flip" id="flip">
        <div class="flip-inner">
          <div class="face face-front">
            <div class="face-grid" aria-hidden="true"></div>
            <div class="face-head">
              <Image src={profile} alt="" width={84} height={84} densities={[1, 2]} format="webp" quality={82} loading="lazy" />
              <div>
                <p class="face-name">{person.name}</p>
                <p class="face-role">{person.title}</p>
                <p class="face-org">{person.company}</p>
              </div>
            </div>
            <div class="face-foot"><span>{person.city}, India</span><span>Java · Spring Boot · Kafka</span></div>
          </div>
          <div class="face face-back">
            <p class="face-label">contact</p>
            <ul>
              <li>{person.email}</li>
              <li>{person.linkedinLabel}</li>
              <li>{person.githubLabel}</li>
              <li class="muted">{person.city}, {person.region}, {person.country}</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="card-actions">
        <button class="btn btn-primary" type="button" id="dl-btn" aria-expanded="false" aria-controls="dl-menu">
          Download card <span aria-hidden="true">▾</span>
        </button>
        <button class="btn btn-ghost" type="button" id="flip-btn" aria-pressed="false">Flip card ↻</button>
        <button class="btn btn-ghost" type="button" id="copy-btn" data-email={person.email}>Copy email</button>
      </div>
      <ul class="dl-menu" id="dl-menu" hidden>
        <li>
          <button type="button" data-dl="png-front">
            <strong>PNG image · front</strong><span>1440 × 840, transparent corners. Great for sharing.</span>
          </button>
        </li>
        <li>
          <button type="button" data-dl="png-back">
            <strong>PNG image · back</strong><span>The contact details side.</span>
          </button>
        </li>
        <li>
          <button type="button" data-dl="pdf">
            <strong>PDF · front + back</strong><span>Two pages at business-card size, ready to print.</span>
          </button>
        </li>
        <li>
          <a href="/Mohammed-Anas.vcf" download data-dl="vcf">
            <strong>Contact file · .vcf</strong><span>Adds me to your phone or address book.</span>
          </a>
        </li>
      </ul>
      <p class="fineprint" id="dl-status" role="status" aria-live="polite">
        Download the card as an image or PDF, or save it straight to your contacts.
      </p>
      <script type="application/json" id="card-data" set:html={JSON.stringify(cardData)} />

      <ul class="social">
        <li><a href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={person.github} target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={`mailto:${person.email}`}>Email</a></li>
      </ul>
    </div>

    <form class="form" id="contact-form" action={site.formEndpoint} method="post" novalidate>
      <div class="field">
        <label for="f-name">name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-email">email</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="f-msg">message</label>
        <textarea id="f-msg" name="message" rows="6" required></textarea>
      </div>
      <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      <button class="btn btn-primary" type="submit" id="form-submit">Send message</button>
    </form>
  </div>
</section>

<style>
  .contact {
    overflow: hidden;
    padding-bottom: 90px;
  }
  .contact > :not(.glow) {
    position: relative;
    z-index: 2;
  }
  .glow {
    width: 520px;
    height: 520px;
    background: #0ea5a0;
    opacity: 0.16;
    right: -120px;
    top: 40px;
    animation: drift2 20s ease-in-out infinite;
  }
  .contact-h {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(40px, 4.4vw, 56px);
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin-bottom: 20px;
  }
  .contact-sub {
    margin-bottom: 56px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 620px;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 80px;
    align-items: start;
  }
  .card-col {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  /* digital visiting card */
  .flip {
    width: min(480px, 100%);
    aspect-ratio: 480 / 280;
    perspective: 1400px;
  }
  .flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.9s var(--ease);
  }
  .flip.is-flipped .flip-inner {
    transform: rotateY(180deg);
  }
  .face {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    overflow: hidden;
    padding: 30px 32px;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border: 1px solid var(--line-3);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(94, 234, 212, 0.1);
  }
  .face-front {
    background: linear-gradient(140deg, #10213f 0%, #0a1222 70%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .face-back {
    background: linear-gradient(140deg, #0a1222 0%, #10213f 100%);
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }
  .face-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(94, 234, 212, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(94, 234, 212, 0.06) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .face-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .face-head :global(img) {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 25%;
    border: 2px solid var(--accent);
  }
  .face-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(22px, 2.2vw, 30px);
    letter-spacing: -0.01em;
  }
  .face-role {
    font-size: 16px;
    color: var(--accent);
    margin-top: 4px;
  }
  .face-org {
    font-size: 14px;
    color: var(--muted);
  }
  .face-foot {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dim);
  }
  .face-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }
  .face-back ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 17px;
    word-break: break-word;
  }
  .face-back .muted {
    color: var(--muted);
  }
  .card-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .fineprint {
    font-size: 13px;
    color: var(--dim);
    max-width: 480px;
    margin-top: -10px;
    min-height: 2.6em;
  }
  .fineprint.is-error {
    color: var(--danger);
  }

  /* download menu */
  #dl-btn span {
    margin-left: 8px;
  }
  .dl-menu {
    width: 100%;
    max-width: 480px;
    margin-top: -12px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: #0c1528;
    border: 1px solid var(--line-3);
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
  }
  .dl-menu[hidden] {
    display: none;
  }
  .dl-menu :is(button, a) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    background: none;
    border: 0;
    border-radius: 10px;
    text-align: left;
    color: var(--text);
    cursor: pointer;
    transition: background 0.2s;
  }
  .dl-menu :is(button, a):hover,
  .dl-menu :is(button, a):focus-visible {
    background: rgba(94, 234, 212, 0.1);
    text-decoration: none;
  }
  .dl-menu strong {
    font-size: 15px;
    font-weight: 600;
  }
  .dl-menu span {
    font-size: 13px;
    color: var(--dim);
    line-height: 1.4;
  }
  .dl-menu [aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
  }
  .social {
    display: flex;
    gap: 28px;
    font-size: 17px;
  }

  /* form */
  .form {
    background: rgba(12, 21, 40, 0.88);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dim);
  }
  .field input,
  .field textarea {
    background: var(--bg);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    padding: 14px 16px;
    min-height: 44px;
    font-size: 16px;
    color: var(--text);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(94, 234, 212, 0.18);
  }
  .field.has-error input,
  .field.has-error textarea {
    border-color: var(--danger);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .form-status {
    min-height: 1.5em;
    font-size: 15px;
    color: var(--muted);
  }
  .form-status.is-error {
    color: var(--danger);
  }
  .form-status.is-ok {
    color: var(--accent);
    font-weight: 600;
  }
  .form .btn {
    align-self: flex-start;
  }
  .form .btn[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  @media (max-width: 1180px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 56px;
    }
  }
  @media (max-width: 720px) {
    .face {
      padding: 20px;
    }
    .face-head {
      gap: 14px;
    }
    .face-head :global(img) {
      width: 64px;
      height: 64px;
    }
    .face-back ul {
      font-size: 14px;
      gap: 10px;
    }
    .form {
      padding: 22px;
    }
    .card-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
