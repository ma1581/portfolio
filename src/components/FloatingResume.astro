---
import { site } from '../data/profile';
---

<a class="fab" id="fab" href={site.resumePdf} download aria-label="Download resume (PDF)">
  <span class="ring r1" aria-hidden="true"></span>
  <span class="ring r2" aria-hidden="true"></span>
  <span class="orbit" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="core">
    <svg class="icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g class="arrow"><path d="M12 3v11" /><path d="m7 10 5 5 5-5" /></g>
      <path class="tray" d="M4 19h16" />
    </svg>
    <span class="fab-text" id="fab-label">Resume</span>
  </span>
</a>

<style>
  .fab {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 60;
    display: grid;
    place-items: center;
    color: var(--accent-ink);
    text-decoration: none;
    /* entrance: hidden until the script adds .is-in, then pops in with overshoot */
    opacity: 0;
    transform: translateY(40px) scale(0.4) rotate(-20deg);
    pointer-events: none;
  }
  .fab:hover {
    text-decoration: none;
  }
  .fab.is-in {
    pointer-events: auto;
    animation: fab-pop 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards, fab-float 4s ease-in-out 1s infinite,
      fab-wiggle 7s ease-in-out 3s infinite;
  }

  /* the button itself: spinning rainbow-ish border around a teal pill */
  .core {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0;
    height: 56px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--accent);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.01em;
    box-shadow: 0 10px 34px rgba(94, 234, 212, 0.45), 0 0 0 2px rgba(7, 12, 23, 0.9);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s, gap 0.35s;
    overflow: hidden;
  }
  .core::before {
    content: '';
    position: absolute;
    inset: -60%;
    z-index: -1;
    background: conic-gradient(from 0deg, #5eead4, #2563eb, #a855f7, #f472b6, #fbbf24, #5eead4);
    animation: fab-spin 3.5s linear infinite;
    opacity: 0.9;
  }
  .core::after {
    content: '';
    position: absolute;
    inset: 3px;
    z-index: -1;
    border-radius: 999px;
    background: var(--accent);
  }
  .fab:hover .core,
  .fab:focus-visible .core {
    transform: scale(1.1);
    gap: 8px;
    box-shadow: 0 14px 46px rgba(94, 234, 212, 0.7), 0 0 0 2px rgba(7, 12, 23, 0.9);
  }
  .fab:active .core {
    transform: scale(0.94);
  }

  /* label: hidden on desktop until hover, always visible on touch / small screens */
  .fab-text {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    white-space: nowrap;
    transition: max-width 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s;
  }
  .fab:hover .fab-text,
  .fab:focus-visible .fab-text,
  .fab.is-busy .fab-text {
    max-width: 120px;
    opacity: 1;
  }

  /* download arrow keeps bouncing into the tray */
  .icon .arrow {
    animation: fab-arrow 1.3s ease-in-out infinite;
  }
  .icon .tray {
    animation: fab-tray 1.3s ease-in-out infinite;
    transform-origin: center;
  }

  /* ripples */
  .ring {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 2px solid var(--accent);
    opacity: 0;
    animation: fab-ripple 2.6s ease-out infinite;
  }
  .ring.r2 {
    animation-delay: 1.3s;
  }

  /* three sparks orbiting the button */
  .orbit {
    position: absolute;
    inset: -14px;
    animation: fab-spin 5s linear infinite;
    pointer-events: none;
  }
  .orbit i {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 10px 3px rgba(94, 234, 212, 0.9);
  }
  .orbit i:nth-child(1) {
    top: 0;
    left: 50%;
  }
  .orbit i:nth-child(2) {
    bottom: 6px;
    left: 8px;
    background: #fbbf24;
    box-shadow: 0 0 10px 3px rgba(251, 191, 36, 0.8);
  }
  .orbit i:nth-child(3) {
    bottom: 6px;
    right: 8px;
    background: #f472b6;
    box-shadow: 0 0 10px 3px rgba(244, 114, 182, 0.8);
  }

  /* confetti pieces are created by script */
  .fab :global(.confetti) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 14px;
    border-radius: 2px;
    pointer-events: none;
    z-index: 3;
  }

  @keyframes fab-pop {
    0% {
      opacity: 0;
      transform: translateY(40px) scale(0.4) rotate(-20deg);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes fab-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -5px;
    }
  }
  @keyframes fab-wiggle {
    0%,
    88%,
    100% {
      rotate: 0deg;
    }
    90% {
      rotate: -12deg;
    }
    92% {
      rotate: 10deg;
    }
    94% {
      rotate: -8deg;
    }
    96% {
      rotate: 6deg;
    }
    98% {
      rotate: -3deg;
    }
  }
  @keyframes fab-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes fab-arrow {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(3px);
    }
  }
  @keyframes fab-tray {
    0%,
    100% {
      transform: scaleX(0.7);
      opacity: 0.6;
    }
    50% {
      transform: scaleX(1);
      opacity: 1;
    }
  }
  @keyframes fab-ripple {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.9, 2.4);
      opacity: 0;
    }
  }

  @media (hover: none), (max-width: 720px) {
    .fab {
      right: 16px;
      bottom: 16px;
    }
    .core {
      height: 50px;
      padding: 0 16px;
      gap: 8px;
      font-size: 14px;
    }
    .fab-text {
      max-width: 120px;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab,
    .fab.is-in {
      animation: none;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .core::before,
    .ring,
    .orbit,
    .icon .arrow,
    .icon .tray {
      animation: none;
    }
    .ring,
    .orbit {
      display: none;
    }
    .core::before {
      display: none;
    }
  }
</style>
