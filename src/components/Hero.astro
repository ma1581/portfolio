---
import { person, hero } from '../data/profile';

const terminalSummary = `Terminal summary: ${hero.terminal.map((l) => l.out).join('; ')}.`;
---

<section id="top" class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="spotlight"></div>
  </div>

  <div class="hero-copy">
    <p class="eyebrow rise" style="--d:.05s">
      <span class="live-dot"></span>{person.title} · {person.city}
    </p>
    <h1 class="hero-name rise" style="--d:.2s">{person.name}</h1>
    <p class="hero-roles rise" style="--d:.35s">
      <span>I build</span>
      <span class="roles" id="roles">
        <span class="sr-only">{hero.roles.join(', ')}.</span>
        {hero.roles.map((role, i) => <span class:list={['role', { 'is-on': i === 0 }]} aria-hidden="true">{role}</span>)}
      </span>
    </p>
    <p class="hero-lead rise" style="--d:.5s">{hero.lead}</p>
    <div class="hero-actions rise" style="--d:.65s">
      <a class="btn btn-primary" href="#contact">Get in touch</a>
      <a class="link-arrow" href="#flip">Download my card ↓</a>
    </div>
  </div>

  <div class="terminal rise" style="--d:.5s" role="img" aria-label={terminalSummary}>
    <div class="term-bar">
      <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
      <span class="term-title">anas@portfolio ~ zsh</span>
    </div>
    <div class="term-body" id="term" aria-hidden="true">
      <div class="scan"></div>
      {hero.terminal.map((l) => <div class="term-line" data-cmd={l.cmd} data-out={l.out} />)}
      <div class="term-prompt"><span class="p">$ </span><span class="cursor"></span></div>
      <button class="term-replay" type="button" hidden>↻ Replay</button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 560px;
    column-gap: 72px;
    align-items: center;
    padding: 110px var(--pad-x) 120px;
    min-height: 760px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(94, 234, 212, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(94, 234, 212, 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 40% 40%, #000 20%, transparent 72%);
    mask-image: radial-gradient(ellipse at 40% 40%, #000 20%, transparent 72%);
  }
  .orb-1 {
    width: 460px;
    height: 460px;
    background: #0ea5a0;
    opacity: 0.28;
    left: -80px;
    top: -120px;
    animation: drift1 16s ease-in-out infinite;
  }
  .orb-2 {
    width: 420px;
    height: 420px;
    background: #2563eb;
    opacity: 0.26;
    right: 80px;
    top: 40px;
    animation: drift2 19s ease-in-out infinite;
  }
  .orb-3 {
    width: 340px;
    height: 340px;
    background: #7c3aed;
    opacity: 0.2;
    left: 40%;
    bottom: -140px;
    animation: drift3 22s ease-in-out infinite;
  }
  .spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(520px circle at var(--mx, 40%) var(--my, 35%), rgba(94, 234, 212, 0.16), transparent 65%);
  }
  .hero-copy,
  .terminal {
    position: relative;
    z-index: 2;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .live-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.2s ease-out infinite;
  }
  .hero-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(52px, 7vw, 88px);
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(100deg, #fff 30%, var(--accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-roles {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-family: var(--font-head);
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 500;
  }
  .roles {
    position: relative;
    flex: 1 1 0;
    min-height: 1.45em;
  }
  .role {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    color: var(--accent);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s, transform 0.6s;
  }
  .role.is-on {
    opacity: 1;
    transform: none;
  }
  .hero-lead {
    font-size: 20px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 620px;
  }
  .hero-actions {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .terminal {
    background: rgba(10, 18, 34, 0.82);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(94, 234, 212, 0.08);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .dot.r {
    background: #ff5f57;
  }
  .dot.y {
    background: #febc2e;
  }
  .dot.g {
    background: #28c840;
  }
  .term-title {
    margin-left: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dim);
  }
  .term-body {
    position: relative;
    overflow: hidden;
    padding: 26px 26px 30px;
    min-height: 330px;
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .scan {
    position: absolute;
    left: 0;
    right: 0;
    height: 70px;
    background: linear-gradient(180deg, transparent, rgba(94, 234, 212, 0.06), transparent);
    animation: scan 5s linear infinite;
    pointer-events: none;
  }
  /* terminal lines are written by script, so these selectors are global */
  .term-line :global(.p),
  .term-prompt .p {
    color: var(--accent);
  }
  .term-line :global(.out) {
    display: block;
    color: var(--muted);
    padding-left: 18px;
  }
  .term-line :global(.cursor),
  .cursor {
    display: inline-block;
    width: 9px;
    height: 1.1em;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1s steps(1) infinite;
  }
  .term-replay {
    align-self: flex-start;
    min-height: 44px;
    padding: 8px 14px;
    border-radius: 8px;
    background: none;
    border: 1px solid var(--line-2);
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
  }
  .term-replay:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  @media (max-width: 1180px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 56px;
      padding-top: 80px;
    }
    .terminal {
      max-width: 640px;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding: 48px var(--pad-x) 64px;
      min-height: 0;
    }
    .hero-lead {
      font-size: 17px;
    }
    .hero-roles {
      flex-direction: column;
      gap: 4px;
    }
    .roles {
      width: 100%;
      min-height: 1.5em;
    }
    .role {
      white-space: normal;
    }
    .term-body {
      padding: 20px 18px 24px;
      font-size: 14px;
      min-height: 300px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .role {
      display: none;
    }
    .role.is-on {
      display: inline;
      opacity: 1;
      transform: none;
    }
  }
</style>
