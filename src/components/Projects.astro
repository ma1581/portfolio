---
import { projectGroups, projects } from '../data/profile';
import SectionHead from './SectionHead.astro';
---

<section id="projects" class="section section-line">
  <SectionHead label="03 / Projects" title="Projects" />

  {
    projectGroups.map((group) => (
      <div class="project-group">
        <p class="sublabel">{group.label}</p>
        <div class="cards-2">
          {projects
            .filter((p) => p.group === group.id)
            .map((p) => (
              <article class="card tilt reveal">
                <p class="meta">{p.meta}</p>
                <h3>{p.title}</h3>
                <p class="blurb">{p.blurb}</p>
                <p class="stack">{p.stack}</p>
                <button class="more-btn" type="button" aria-expanded="false" aria-controls={`proj-${p.id}`}>
                  <span class="more-label">View details</span>
                </button>
                <div class="acc-panel" id={`proj-${p.id}`}>
                  <div class="acc-inner">
                    <ul class="bullets">{p.details.map((d) => <li>{d}</li>)}</ul>
                    {p.href && (
                      <a class="link-arrow" href={p.href} target="_blank" rel="noopener">
                        {p.linkLabel}
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))}
        </div>
      </div>
    ))
  }
</section>

<style>
  .project-group + .project-group {
    margin-top: 64px;
  }
  .cards-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }
  h3 {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 28px;
  }
  .blurb {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .stack {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dim);
  }
  .more-btn {
    align-self: flex-start;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
    font-size: 15px;
  }
  .more-btn::after {
    content: ' ↓';
    display: inline-block;
    transition: transform 0.3s;
  }
  .more-btn[aria-expanded='true']::after {
    transform: rotate(180deg);
  }
  .acc-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .acc-panel.is-open .acc-inner {
    padding-top: 8px;
  }

  @media (max-width: 720px) {
    .cards-2 {
      grid-template-columns: minmax(0, 1fr);
    }
    h3 {
      font-size: 22px;
    }
  }
</style>
