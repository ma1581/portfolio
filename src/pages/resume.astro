---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import { certifications, education, experience, person, projects, resume, site, skillCategories, skills } from '../data/profile';

const intern = experience.find((role) => role.id === 'intern');
const personal = projects.filter((p) => p.group === 'personal');
const skillLines = skillCategories.map((cat) => ({
  label: cat.label,
  items: skills.filter((s) => s.cat === cat.id).map((s) => s.name),
}));
const host = new URL(site.url).host;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{person.name} – Resume</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="page">
      <header>
        <h1>{person.name}</h1>
        <p class="role">{person.title} · {person.company}</p>
        <p class="contact">
          {person.city}, {person.region} ·
          <a href={`mailto:${person.email}`}>{person.email}</a> ·
          <a href={person.linkedin}>{person.linkedinLabel}</a> ·
          <a href={person.github}>{person.githubLabel}</a> ·
          <a href={site.url}>{host}</a>
        </p>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{resume.summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        <div class="entry">
          <div class="entry-head">
            <p><strong>SDE II</strong>, {person.company}</p>
            <p class="when">Oct 2024 – Present</p>
          </div>
          <ul>{resume.sde2Bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
        {
          intern && (
            <div class="entry">
              <div class="entry-head">
                <p><strong>{intern.title}</strong></p>
                <p class="when">{intern.meta.split(' · ').pop()}</p>
              </div>
              <ul>{intern.groups.flatMap((g) => g.bullets).map((b) => <li>{b}</li>)}</ul>
            </div>
          )
        }
      </section>

      <section>
        <h2>Skills</h2>
        <dl>
          {
            skillLines.map((line) => (
              <>
                <dt>{line.label}</dt>
                <dd>{line.items.join(', ')}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <section>
        <h2>Projects</h2>
        {
          personal.map((p) => (
            <div class="entry">
              <div class="entry-head">
                <p><strong>{p.title}</strong> · {p.stack}</p>
                <p class="when">{p.meta}</p>
              </div>
              <p class="line">{p.blurb}</p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Education</h2>
        <div class="entry-head">
          <p><strong>{education.degree}</strong>, {education.school}</p>
          <p class="when">{education.period}</p>
        </div>
      </section>

      <section>
        <h2>Certifications &amp; languages</h2>
        <p class="line">
          {certifications.map((c) => c.title).join(' · ')}
        </p>
        <p class="line"><strong>Languages:</strong> {person.languages.join(', ')}</p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 10mm 13mm;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #e9edf2;
    color: #1a2230;
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-size: 9.1pt;
    line-height: 1.33;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .page {
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 10mm 13mm;
    background: #fff;
  }
  h1,
  h2,
  p,
  ul,
  dl,
  dd {
    margin: 0;
  }
  h1 {
    font-family: 'Space Grotesk Variable', 'Inter Variable', sans-serif;
    font-size: 22pt;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .role {
    margin-top: 3pt;
    font-size: 11pt;
    color: #0f766e;
    font-weight: 600;
  }
  .contact {
    margin-top: 4pt;
    color: #4b5666;
    font-size: 8.6pt;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  h2 {
    margin: 8pt 0 4pt;
    padding-bottom: 2pt;
    border-bottom: 0.75pt solid #c9d2de;
    font-family: 'Space Grotesk Variable', 'Inter Variable', sans-serif;
    font-size: 10.5pt;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0f766e;
  }
  .entry + .entry {
    margin-top: 5pt;
  }
  .entry-head {
    display: flex;
    justify-content: space-between;
    gap: 12pt;
    break-after: avoid;
  }
  .when {
    color: #4b5666;
    white-space: nowrap;
    font-size: 9pt;
  }
  ul {
    margin-top: 2.5pt;
    padding-left: 12pt;
  }
  li {
    margin-bottom: 1.2pt;
  }
  dl {
    display: grid;
    grid-template-columns: 31mm 1fr;
    row-gap: 2pt;
  }
  dt {
    font-weight: 600;
  }
  .line {
    margin-top: 1.5pt;
  }
  @media print {
    body {
      background: #fff;
    }
    .page {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
    }
  }
</style>
